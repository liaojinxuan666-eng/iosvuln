#!/bin/bash
set -e

# Rootless jailbreak: the package is installed under /var/jb/usr, NOT /usr.
# On rootful devices /var/jb/usr may be a symlink target, but we detect both.
JB=""
for candidate in /var/jb /; do
  if [ -d "$candidate/usr/lib/iosvuln" ]; then
    JB="$candidate"
    break
  fi
done

BIN_DIR="${JB}/usr/bin"
LIB_DIR="${JB}/usr/lib/iosvuln"
chmod 0755 "$BIN_DIR/iosvuln" 2>/dev/null || true

# Initialize the COMPLETE persistent store with the exact same layout as the
# host tool. Reuse the tool itself so the structure never drifts.
export PYTHONPATH="${LIB_DIR}${PYTHONPATH:+:$PYTHONPATH}"
if command -v python3 >/dev/null 2>&1; then
  python3 -m iosvuln.cli home --init >/dev/null 2>&1 || true
else
  # Fallback: create every subdir by hand if python3 is not yet available.
  BASE=/var/mobile/iosvuln
  mkdir -p "$BASE/collections" "$BASE/cache/kexts" "$BASE/reports" \
           "$BASE/tweaks" "$BASE/logs"
fi

# Wire zsh shortcuts into root and mobile shells (idempotent).
# Remove any stale rootful line first, then add the resolved path.
for rc in /var/root/.zshrc /var/mobile/.zshrc; do
  [ -f "$rc" ] || touch "$rc" 2>/dev/null || continue
  sed -i '' '/source \/usr\/lib\/iosvuln\/iosvuln\.zsh/d' "$rc" 2>/dev/null || \
    sed -i '/source \/usr\/lib\/iosvuln\/iosvuln\.zsh/d' "$rc" 2>/dev/null || true
  SHORTCUT="source ${LIB_DIR}/iosvuln.zsh"
  grep -Fqx "$SHORTCUT" "$rc" 2>/dev/null || echo "$SHORTCUT" >> "$rc" 2>/dev/null || true
done
chown -R mobile:mobile /var/mobile/iosvuln 2>/dev/null || true
exit 0
